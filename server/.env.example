PORT=4000

DATABASE_URL=postgres://postgres:postgres@localhost:5432/menu_calorie_scanner

# Adapter selection: 'stub' uses deterministic local logic, no external calls / API keys needed.
OCR_PROVIDER=stub
AI_PROVIDER=stub        # stub | claude | openrouter — 'openrouter' does LLM dish-name detection (needs OPENROUTER_API_KEY)
NUTRITION_PROVIDER=stub # stub | claude | openrouter — 'openrouter' seed-first, then LLM-estimates dishes not in the seed DB
STORAGE_PROVIDER=local-disk

# Only needed when the corresponding provider above is switched away from 'stub' / 'local-disk'.
GOOGLE_VISION_API_KEY=
OPENROUTER_API_KEY=     # OpenRouter key (https://openrouter.ai/keys) — used when AI_PROVIDER=openrouter
OPENROUTER_MODEL=       # optional model override, e.g. meta-llama/llama-3.3-70b-instruct:free (see https://openrouter.ai/models?max_price=0)
ANTHROPIC_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=
